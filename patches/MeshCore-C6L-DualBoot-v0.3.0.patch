+static void c6lPlayRadioRainBoot() {
+  static constexpr char RADIO_RAIN_CHARS[] = "01ABCDEFXYZ";
+  static constexpr uint8_t COLS = 7;
+  static constexpr uint8_t TAIL = 3;
+  static constexpr uint32_t DURATION_MS = 5000;
+  static constexpr uint32_t FRAME_MS = 83;  // ~12 FPS
+
+  int16_t head[COLS];
+  uint8_t speed[COLS];
+  uint8_t seed[COLS];
+
+  uint32_t rng = micros() ^ 0xC6D00B1Eu;
+
+  auto nextRand = [&]() -> uint32_t {
+    rng = rng * 1664525u + 1013904223u;
+    return rng;
+  };
+
+  for (uint8_t i = 0; i < COLS; ++i) {
+    head[i] = -12 - static_cast<int16_t>(i * 9) - static_cast<int16_t>(nextRand() % 12);
+    speed[i] = 2 + (nextRand() % 2);
+    seed[i] = nextRand() % (sizeof(RADIO_RAIN_CHARS) - 1);
+  }
+
+  const uint32_t started = millis();
+  uint32_t frame = 0;
+  bool skip_armed = false;
+
+  while ((uint32_t)(millis() - started) < DURATION_MS) {
+    const bool pressed = board.isButtonPressed();
+
+    if (!skip_armed) {
+      if (!pressed) skip_armed = true;
+    } else if (pressed) {
+      return;
+    }
+
+    display.startFrame();
+    display.setTextSize(1);
+    display.setColor(SSD1306_WHITE);
+
+    for (uint8_t col = 0; col < COLS; ++col) {
+      const int16_t x = 3 + col * 9;
+
+      for (uint8_t tail = 0; tail < TAIL; ++tail) {
+        const int16_t y = head[col] - tail * 8;
+
+        if (y >= 0 && y <= 40) {
+          const uint8_t idx =
+              (seed[col] + tail + frame / 2 + col) %
+              (sizeof(RADIO_RAIN_CHARS) - 1);
+
+          display.setCursor(x, y);
+          char rain_char[2] = { RADIO_RAIN_CHARS[idx], '\0' };
+          display.print(rain_char);
+        }
+      }
+
+      head[col] += speed[col];
+
+      if (head[col] > 48 + TAIL * 8) {
+        head[col] = -24 - static_cast<int16_t>(nextRand() % 48);
+        speed[col] = 2 + (nextRand() % 2);
+        seed[col] = nextRand() % (sizeof(RADIO_RAIN_CHARS) - 1);
+      }
+    }
+
+    display.endFrame();
+    ++frame;
+    delay(FRAME_MS);
+  }
+}
