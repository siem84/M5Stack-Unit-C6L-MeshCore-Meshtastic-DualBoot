+
+// Only raw advert cache entries are disposable, never contact records or prefs.
+static bool c6lMakePrefsRoom(size_t required) {
+  for (;;) {
+    const esp_err_t gc = esp_spiffs_gc(C6L_SPIFFS_PARTITION_LABEL, required);
+    if (gc == ESP_OK) return true;
+    if (gc != ESP_ERR_NOT_FINISHED) return false;
+    String victim;
+    time_t oldest = 0;
+    File root = SPIFFS.open("/", "r");
+    if (!root || !root.isDirectory()) { root.close(); return false; }
+    for (File f = root.openNextFile("r"); f; f = root.openNextFile("r")) {
+      const String path = f.path();
+      const time_t modified = f.getLastWrite();
+      bool cache = !f.isDirectory() && path.startsWith("/bl/") &&
+                   path.length() >= 6 && path.length() <= 20 && path.length() % 2 == 0;
+      for (size_t i = 4; cache && i < path.length(); ++i) {
+        const char c = path[i];
+        cache = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
+      }
+      f.close();
+      if (cache && (!victim.length() || modified < oldest ||
+                    (modified == oldest && path.compareTo(victim) < 0))) {
+        victim = path;
+        oldest = modified;
+      }
+    }
+    root.close();
+    if (!victim.length() || !SPIFFS.remove(victim)) return false;
+    // Each iteration removes one existing cache entry, so the loop is bounded.
+  }
+}
