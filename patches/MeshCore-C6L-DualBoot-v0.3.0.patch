@@ -0,0 +1,46 @@
+#include "DualBoot.h"
+
+#if defined(ESP32) && defined(MESHCORE_DUALBOOT)
+
+#include <Arduino.h>
+#include <esp_partition.h>
+#include <esp_ota_ops.h>
+
+void configureDualBootNextPartition() {
+  const esp_partition_t* running = esp_ota_get_running_partition();
+  if (running == nullptr) {
+    Serial.println("DUALBOOT: running partition unavailable; keeping current system");
+    return;
+  }
+
+  esp_partition_subtype_t target_subtype;
+  if (running->subtype == ESP_PARTITION_SUBTYPE_APP_OTA_0) {
+    target_subtype = ESP_PARTITION_SUBTYPE_APP_OTA_1;
+  } else if (running->subtype == ESP_PARTITION_SUBTYPE_APP_OTA_1) {
+    target_subtype = ESP_PARTITION_SUBTYPE_APP_OTA_0;
+  } else {
+    Serial.printf("DUALBOOT: unsupported running subtype 0x%02x; keeping current system\n",
+                  running->subtype);
+    return;
+  }
+
+  const esp_partition_t* target = esp_partition_find_first(
+      ESP_PARTITION_TYPE_APP, target_subtype, nullptr);
+  if (target == nullptr) {
+    Serial.printf("DUALBOOT: target for running %s is missing; keeping current system\n",
+                  running->label);
+    return;
+  }
+
+  Serial.printf("DUALBOOT: running=%s target=%s\n", running->label, target->label);
+  const esp_err_t result = esp_ota_set_boot_partition(target);
+  if (result != ESP_OK) {
+    Serial.printf("DUALBOOT: cannot set %s as next boot: %s (0x%x); continuing\n",
+                  target->label, esp_err_to_name(result), result);
+    return;
+  }
+
+  Serial.printf("DUALBOOT: next boot set to %s; no restart requested\n", target->label);
+}
+
+#endif
