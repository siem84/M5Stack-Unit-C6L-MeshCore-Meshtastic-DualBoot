diff --git a/test/test_dualboot_partition.py b/test/test_dualboot_partition.py
new file mode 100644
index 00000000..1fc4b88c
--- /dev/null
+++ b/test/test_dualboot_partition.py
@@ -0,0 +1,82 @@
+from pathlib import Path
+import csv
+import sys
+
+FLASH_SIZE = 0x1000000
+APP_ALIGNMENT = 0x10000
+DATA_ALIGNMENT = 0x1000
+
+
+def parse_table(path):
+    partitions = []
+    with path.open(newline="") as stream:
+        for row in csv.reader(line for line in stream if not line.lstrip().startswith("#")):
+            if not row or not row[0].strip():
+                continue
+            name, kind, subtype, offset, size, *_ = [field.strip() for field in row]
+            partitions.append((name, kind, subtype, int(offset, 0), int(size, 0)))
+    return partitions
+
+
+def check(path):
+    partitions = parse_table(path)
+    by_name = {partition[0]: partition for partition in partitions}
+    assert len(by_name) == len(partitions), "duplicate partition name"
+
+    ranges = []
+    for name, kind, subtype, offset, size in partitions:
+        assert size > 0, f"{name}: non-positive size"
+        end = offset + size
+        assert end <= FLASH_SIZE, f"{name}: exceeds 16 MB flash"
+        alignment = APP_ALIGNMENT if kind == "app" else DATA_ALIGNMENT
+        assert offset % alignment == 0, f"{name}: offset alignment"
+        assert size % alignment == 0, f"{name}: size alignment"
+        ranges.append((offset, end, name))
+
+    ranges.sort()
+    for previous, current in zip(ranges, ranges[1:]):
+        assert previous[1] <= current[0], f"overlap: {previous[2]} and {current[2]}"
+
+    for name, kind, subtype, expected_subtype in (
+        ("app0", "app", "ota_0", "ota_0"),
+        ("app1", "app", "ota_1", "ota_1"),
+    ):
+        partition = by_name[name]
+        assert partition[1:3] == (kind, expected_subtype), f"{name}: wrong type/subtype"
+        assert partition[4] == 0x640000, f"{name}: wrong slot size"
+
+    ordered = ["app0", "app1", "spiffs", "mc_spiffs", "coredump"]
+    for first, second in zip(ordered, ordered[1:]):
+        assert by_name[first][3] + by_name[first][4] <= by_name[second][3], \
+            f"ordering: {first} must end before {second}"
+    assert ranges[-1][1] <= FLASH_SIZE
+
+    print(f"PASS: {path}")
+    for name, kind, subtype, offset, size in partitions:
+        print(f"  {name}: 0x{offset:06X}-0x{offset + size:06X} ({size:#x})")
+
+
+def check_boot_helper(path):
+    source = path.read_text()
+    required = (
+        "esp_ota_get_running_partition",
+        "esp_partition_find_first",
+        "esp_ota_set_boot_partition",
+        "ESP_PARTITION_SUBTYPE_APP_OTA_0",
+        "ESP_PARTITION_SUBTYPE_APP_OTA_1",
+    )
+    for token in required:
+        assert token in source, f"boot helper missing {token}"
+    assert "esp_restart" not in source, "boot helper must not restart"
+    print(f"PASS: {path} boot contract")
+
+
+if __name__ == "__main__":
+    table = Path(__file__).parents[1] / "variants" / "m5stack_unit_c6l" / "dualboot_c6l_16MB.csv"
+    helper = Path(__file__).parents[1] / "src" / "helpers" / "esp32" / "DualBoot.cpp"
+    try:
+        check(table)
+        check_boot_helper(helper)
+    except (AssertionError, OSError, ValueError) as error:
+        print(f"FAIL: {error}", file=sys.stderr)
+        raise SystemExit(1)
