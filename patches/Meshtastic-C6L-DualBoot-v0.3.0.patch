diff --git a/src/platform/esp32/DualBootC6L.cpp b/src/platform/esp32/DualBootC6L.cpp
new file mode 100644
index 000000000..8529775c7
--- /dev/null
+++ b/src/platform/esp32/DualBootC6L.cpp
@@ -0,0 +1,47 @@
+#include "DualBootC6L.h"
+
+#if defined(MESHTASTIC_DUALBOOT_C6L)
+
+#include "configuration.h"
+#include "main.h"
+#include <esp_err.h>
+#include <esp_ota_ops.h>
+#include <esp_partition.h>
+
+void configureDualBootC6LNextPartition()
+{
+    const esp_partition_t *running = esp_ota_get_running_partition();
+    if (running == nullptr) {
+        LOG_WARN("DUALBOOT: running partition unavailable; keeping current system");
+        return;
+    }
+
+    esp_partition_subtype_t target_subtype;
+    if (running->subtype == ESP_PARTITION_SUBTYPE_APP_OTA_1) {
+        target_subtype = ESP_PARTITION_SUBTYPE_APP_OTA_0;
+    } else if (running->subtype == ESP_PARTITION_SUBTYPE_APP_OTA_0) {
+        target_subtype = ESP_PARTITION_SUBTYPE_APP_OTA_1;
+    } else {
+        LOG_WARN("DUALBOOT: unsupported running subtype 0x%02x; keeping current system", running->subtype);
+        return;
+    }
+
+    const esp_partition_t *target =
+        esp_partition_find_first(ESP_PARTITION_TYPE_APP, target_subtype, nullptr);
+    if (target == nullptr) {
+        LOG_WARN("DUALBOOT: target partition missing; keeping current system");
+        return;
+    }
+
+    LOG_INFO("DUALBOOT: running=%s target=%s", running->label, target->label);
+    const esp_err_t result = esp_ota_set_boot_partition(target);
+    if (result != ESP_OK) {
+        LOG_WARN("DUALBOOT: cannot set %s as next boot: %s (0x%x); continuing", target->label,
+                 esp_err_to_name(result), result);
+        return;
+    }
+
+    LOG_INFO("DUALBOOT: next boot set to %s; no restart requested", target->label);
+}
+
+#endif
